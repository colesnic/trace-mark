# TraceMark environment configuration
# Copy to .env and fill in real values. Never commit secrets.

TRACEMARK_ENV=development

TRACEMARK_DATABASE_URL=sqlite+aiosqlite:///./tracemark.db

# Base64-encoded root master key (>= 32 random bytes).
# Generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
TRACEMARK_MASTER_KEY=

# Development-only admin token for admin endpoints.
TRACEMARK_ADMIN_TOKEN=

# Provider API keys (optional, only needed for the LLM proxy).
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional development-only raw content retention.
TRACEMARK_RETAIN_RAW=false
